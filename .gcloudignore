# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore.

# Node modules
node_modules/

# Source files (not needed for deployment)
src/

# Development files
*.log
.vscode/
.idea/
.DS_Store

# Git
.git/
.gitignore

# Firebase
.firebase/

# Other
*.local
*.sw?
